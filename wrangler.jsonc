{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skyblush",
  "main": "server.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_modules",
    "enable_nodejs_http_server_modules"
  ],
  "assets": {
    "directory": "./public"
  }
}